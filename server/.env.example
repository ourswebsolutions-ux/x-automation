# X Auto activation server. Copy to .env and fill in. Never commit .env.

# ── Network ──
PORT=8787
HOST=127.0.0.1
# Set to 1 only behind a reverse proxy you control (it must set X-Forwarded-For).
TRUST_PROXY=0

# ── Storage ──
DATABASE_PATH=./data/activation.db

# ── SMTP: OTP emails go to ADMIN_EMAIL and nowhere else ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# ── Secrets: generate both with `npm run keys` ──
OTP_PEPPER=
SIGNING_PRIVATE_KEY=

# ── Plans: a plan is not offered until its price is set ──
PLAN_CURRENCY=
PLAN_MONTHLY_PRICE=
PLAN_MONTHLY_DAYS=30
PLAN_SIX_MONTHS_PRICE=
PLAN_LIFETIME_PRICE=

# ── Entitlement lease: how long a device may run without reaching this server ──
LEASE_DAYS=7
